&CONTROL
   calculation      = 'relax'
   restart_mode     = 'from_scratch'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './tmp_Ni'
   prefix           = 'Ni'
   pseudo_dir       = '/content'
/
&SYSTEM
   starting_magnetization(1) = 0.6
   ecutwfc          = 80
   ecutrho          = 500
   occupations      = 'smearing'
   degauss          = 0.015
   smearing         = 'methfessel-paxton'
   nspin            = 2
   input_dft        = 'pbe'
   ntyp             = 1
   nat              = 4
   ibrav            = 0
/
&ELECTRONS
   conv_thr         = 1e-08
   mixing_mode      = 'local-TF'
   mixing_beta      = 0.7
   mixing_ndim      = 8
   diagonalization  = 'david'
   diago_david_ndim = 6
/
&IONS
   ion_dynamics     = 'bfgs'
/
&CELL
   cell_dynamics    = 'bfgs'
   press_conv_thr   = 0.1
/
&FCP
/
&RISM
/
ATOMIC_SPECIES
Ni  58.6934 Ni.pbe-spn-kjpaw_psl.1.0.0.UPF

K_POINTS automatic
8 8 8  0 0 0

